{
  "name": "cyber-security-operations-platform",
  "version": "2.0.0",
  "description": "Professional corporate security operations platform for authorized environments",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prod": "node server.js",
    "service": "node service-wrapper.js",
    "build:windows:setup": "powershell -ExecutionPolicy Bypass -File .\\build-game-installer.ps1",
    "test": "node --test",
    "analyze:threat": "node tools/threat-analyzer/cli.js",
    "analyze:intrusion": "node tools/threat-analyzer/cli.js intrusion --input tools/threat-analyzer/samples/intrusion-events.json",
    "analyze:malware": "node tools/threat-analyzer/cli.js malware --file tools/threat-analyzer/samples/suspicious-loader.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.0",
    "express": "^4.19.2"
  }
}
