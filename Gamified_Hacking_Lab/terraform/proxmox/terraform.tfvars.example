# Optional: this file can be generated from ../.env via scripts/load-secrets.ps1
proxmox_api_url      = "https://proxmox.local:8006/api2/json"
proxmox_api_token    = "root@pam!terraform=REPLACE_ME"
proxmox_insecure_tls = true

proxmox_node      = "pve"
proxmox_datastore = "local-lvm"

template_attacker = "9000"
template_target   = "9001"
template_soc      = "9002" # set to "" to disable SOC VM

ssh_public_key = "ssh-ed25519 AAAA...replace_me"

bridge = "vmbr1"
