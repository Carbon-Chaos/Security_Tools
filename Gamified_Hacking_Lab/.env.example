# Copy this file to .env and fill values.
# Option 3 in Mission Control can auto-detect host from PROXMOX_HOST or PROXMOX_API_URL.
PROXMOX_HOST=10.0.0.10
PROXMOX_API_URL=https://10.0.0.10:8006/api2/json
PROXMOX_API_TOKEN=root@pam!terraform=REPLACE_ME
PROXMOX_NODE=pve
PROXMOX_DATASTORE=local-lvm
PROXMOX_INSECURE_TLS=true
SSH_PUBLIC_KEY=ssh-ed25519 AAAA...replace_me
TEMPLATE_ATTACKER=9000
TEMPLATE_TARGET=9001
TEMPLATE_SOC=9002
BRIDGE=vmbr1
